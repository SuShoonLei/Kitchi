# Copy to .env and change the password before sharing a machine.
# These values are placeholders. Do not put real passwords here.

POSTGRES_DB=kitchi
POSTGRES_USER=kitchi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/kitchi
DB_USER=kitchi
DB_PASSWORD=change-me
ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080

# Frontend public edition (default). Leave DATA_MODE unset or set to local.
# NEXT_PUBLIC_DATA_MODE=local

# Full-stack edition against the Spring Boot API.
# NEXT_PUBLIC_DATA_MODE=api
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Photo scan (Beta). Default on. Set to false to hide Photo mode.
# NEXT_PUBLIC_ENABLE_PHOTO_SCAN=true

# Optional. Tests use these only when Docker is unavailable.
# Point them at an empty database. These are placeholders.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/kitchi_test
# TEST_DB_USER=kitchi
# TEST_DB_PASSWORD=change-me
